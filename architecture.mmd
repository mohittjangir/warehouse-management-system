graph TD
    classDef client fill:#3b82f6,stroke:#1d4ed8,stroke-width:2px,color:#fff,rx:8px
    classDef frontend fill:#10b981,stroke:#047857,stroke-width:2px,color:#fff,rx:8px
    classDef backend fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff,rx:8px
    classDef db fill:#f59e0b,stroke:#b45309,stroke-width:2px,color:#fff,rx:8px
