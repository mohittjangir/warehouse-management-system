# Environment
ENV=development

# Database
# SQLite (default for development - no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./warehouse.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/warehouse_db

# JWT Settings
SECRET_KEY=change-this-to-a-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed Admin Credentials (development only)
ADMIN_EMAIL=admin@warehouse.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin
